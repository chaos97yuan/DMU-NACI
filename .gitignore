# --- data: never commit raw or derived observations --------------------------
data/raw/
data/processed/
*.npy
*.parquet
data/*.csv
!data/synthetic_example.csv

# --- pipeline outputs regenerated by reruns ---------------------------------
outputs/
logs/
results/**/*.log.tmp
# data-derived intermediates regenerated from raw DKASC; keep the audit JSONs
results/rigorous_v2/data/*
!results/rigorous_v2/data/*_audit.json
results/rigorous_v2/s3_e24_oof/*.parquet
results/rigorous_v2/s4_replay/*.parquet
results/rigorous_v2/s5_vintage/*.parquet
results/rigorous_v2/s7_final_eval/per_sample_*.parquet
results/rigorous_v2/s7_final_eval/mu_spans.npz
results/rigorous_v2/s7_final_eval/final_mean_cache.npz
results/site1b_val/*.npz

# --- python / os junk --------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- editor / system ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
*Zone.Identifier*
matplotlib/

